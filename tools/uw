def cmd_hear(agent: str, args: argparse.Namespace, json_mode: bool) -> None:
    place = load_state().get("place", DEFAULT_PLACE)
    explicit_since = args.since is not None
    since = args.since if explicit_since else load_state().get(f"cursor_{place}")
    payload: dict[str, Any] = {"agent": agent, "place": place}
    if since is not None:
        payload["since"] = since
    # umwelt#616: bound the read by default — --all opts back into the old
    # fully-unbounded behavior (omit `limit` entirely; the server stays on
    # its unbounded back-compat branch since we never send `advance`
    # either). --limit lets a caller pick their own window; the server
    # clamps it to _CROSSINGS_MAX_LIMIT regardless of what we send.
    #
    # Reviewer-fairy finding on PR#704: `--limit 0` must be refused, not
    # silently sent — the server's own `if limit_raw:` check treats 0 the
    # SAME as absent (Python truthiness), so a payload with `limit: 0`
    # would silently fall through to the fully-unbounded branch, quietly
    # reopening the exact bug this fix exists to close. A non-positive
    # limit has no sensible meaning here anyway (there's no "read zero
    # crossings" use case) — refuse it loudly instead.
    if not args.all:
        if args.limit is not None and args.limit < 1:
            raise UwError(
                f"--limit must be a positive integer, got {args.limit} "
                f"(use --all for unbounded, or omit --limit for the "
                f"default of {_HEAR_DEFAULT_LIMIT})")
        payload["limit"] = args.limit if args.limit is not None else _HEAR_DEFAULT_LIMIT
    resp = request("POST", "/umwelt/crossings_here", payload)
    # Cursor rule: only a PLAIN hear (no --since) advances the cursor.
    if not explicit_since and resp.get("to_position") is not None:
        save_state(**{f"cursor_{place}": resp["to_position"]})
    _print_json(resp) if json_mode else print(_render_hear(resp, place))


def cmd_look_at(agent: str, args: argparse.Namespace, json_mode: bool) -> None:
    # look_at's own avatar-inclusive resolution (umwelt #146) — NOT
    # _resolve_thing, which every other thing-ref verb still uses
    # unchanged (avatars must stay un-take/use/drop/put-able).
    thing_id = _resolve_look_at_target(agent, args.thing)
    resp = request("POST", "/umwelt/look_at", {"agent": agent, "thing": thing_id})
    if json_mode:
        _print_json(resp)
        return
    thing = resp.get("thing", {})
    lines = [_render_thing(thing)]
    # #143: `status` is a sibling key to `thing`, present only when the
    # target is an avatar-kind thing (the server's own gate — see
    # server.py's look_at route) — mirror that same gate here rather than
    # rendering on `status`'s mere presence alone.
    status = resp.get("status")
    if status is not None and thing.get("kind") == "avatar":
        lines.append(_render_avatar_status(status))
    # umwelt #182: `checklist_render` is a sibling key to `thing`, present
    # only when the target has a non-empty metadata.checklist (the server's
    # own gate — see server.py's look_at route / _render_checklist) — same
    # "mirror the gate, don't guess from presence alone" posture as `status`
    # above. Makes a checklist readable via plain `uw look_at`, not just
    # --json.
    checklist_render = resp.get("checklist_render")
    if checklist_render is not None:
        lines.append(checklist_render)
    # umwelt #227/#249 dogfood friction (Ariadne, forum #268/#4753):
    # `board_render` is a sibling key to `thing`, present only for a bound
    # project_board instance (the server's own gate — see server.py's
    # look_at route / _render_project_board) — same "omitted entirely when
    # N/A, presence-check alone suffices" posture as `checklist_render`
    # above. Without this, `uw look_at <board>` (plain text) silently
    # looked like boards had no task list at all, even though --json's
    # board_render carried the full render the whole time.
    board_render = resp.get("board_render")
    if board_render is not None:
        lines.append(board_render)
    print("\n".join(lines))


