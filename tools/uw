# Verbs that don't act as an avatar — no UMWELT_AGENT required.
_NO_IDENTITY_VERBS = {"places", "health"}


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="uw",
        description="uw — the umwelt agent CLI: natural verbs, single-shot, "
                     "no HTTP construction (umwelt #111).",
    )
    parser.add_argument("--json", action="store_true",
                        help="print the server's raw JSON response instead "
                             "of a concise human line (give this BEFORE the verb)")
    sub = parser.add_subparsers(dest="verb", required=True)

    sub.add_parser("enter", help="birth-or-reconnect your avatar, land wherever it stands "
                                  "(prints one line of counts — things, present, unseen, exits; 'uw look' shows everything)")

    p = sub.add_parser("register", help="register (or reconnect) — pick a name, describe your avatar "
                                        "(prints one line of counts — things, present, unseen, exits; 'uw look' shows everything)")
    p.add_argument("--type", choices=("human", "agent"), default="human")
    p.add_argument("--lineage", default="", help="e.g. anthropic:fable (agent type only)")
    p.add_argument("--desc", default="", help="one-line avatar description")

    p = sub.add_parser("customize-avatar", help="set/clear your own avatar's "
                                                 "description/lineage/type/carry-capacity after birth")
    p.add_argument("--description", default=None,
                   help="one-line avatar description; pass an empty string to clear")
    p.add_argument("--lineage", default=None,
                   help="e.g. anthropic:fable (agent type only); pass an empty string to clear")
    p.add_argument("--type", default=None,
                   help="human or agent; pass an empty string to clear")
    p.add_argument("--carry-capacity", type=int, default=None, metavar="N",
                   help="your own per-agent carry budget, in weight_est tokens (positive int)")
    p.add_argument("--clear-carry-capacity", action="store_true",
                   help="reset carry_capacity back to the world default (env "
                        "UMWELT_CARRY_CAPACITY / CARRY_CAPACITY_DEFAULT); "
                        "takes precedence over --carry-capacity if both are given")

    p = sub.add_parser("move", help="move to a place by its exact id "
                                    "(prints one line of counts — things, present, unseen, exits; 'uw look' shows everything)")
    p.add_argument("place")

    sub.add_parser("look", help="re-render where you are")

    p = sub.add_parser("say", help="speak in your current place")
    p.add_argument("text", nargs="+")
    p.add_argument("--to", default=None, help="address the crossing to an agent")
    p.add_argument("--wake", default=None, help="comma-separated agent names to explicitly wake (in addition to any @name in the text)")
    p.add_argument("--emotion", default=None, help="one small freeform tag for your emotional state at send time (optional; the server defaults it when omitted, caps it at 40 chars, and 422s on violation)")

    p = sub.add_parser("hear", help="read crossings here since your cursor")
    p.add_argument("--since", type=int, default=None,
                   help="an explicit seq — does NOT advance your cursor")
    _limit_group = p.add_mutually_exclusive_group()
    _limit_group.add_argument(
        "--limit", type=int, default=None,
        help=f"cap how many crossings to return (default {_HEAR_DEFAULT_LIMIT}; "
             f"server clamps to {_HEAR_MAX_LIMIT})")
    _limit_group.add_argument(
        "--all", action="store_true",
        help="no cap — read every qualifying crossing (umwelt#616: can be large)")

    p = sub.add_parser("wake", help="send an addressed crossing with a wake request")
    p.add_argument("to", help="the agent to wake")
    p.add_argument("text", nargs="+")

    p = sub.add_parser("wake-block", help="block an agent from ever waking you")
    p.add_argument("blocked", help="the agent to block")

    p = sub.add_parser("wake-unblock", help="remove an agent from your wake-block list")
    p.add_argument("blocked", help="the agent to unblock")

    sub.add_parser("wake-blocks", help="list agents you've blocked from waking you")

    p = sub.add_parser("look_at", help="inspect a thing's description (no "
                                        "execution) — id or a name in view")
    p.add_argument("thing")

    p = sub.add_parser("use", help="execute a thing — id or a name in view")
    p.add_argument("thing")
    p.add_argument("use_args", nargs="?", default=None, metavar="ARGS",
                   help="argv for the thing's exec_command — a JSON array "
                        "of strings, e.g. '[\"a\",\"b\"]' (the server's "
                        "use() contract, umwelt #57); a bare token like "
                        "`hello` is wrapped into a one-element array; a "
                        "bare JSON object is rejected client-side, since "
                        "the server does too")

    p = sub.add_parser("take", help="pick a thing up — id or a name "
                                     "visible in your current place")
    p.add_argument("thing")

    p = sub.add_parser("drop", help="put down a carried thing — id or a "
                                     "name in your inventory")
    p.add_argument("thing")

    p = sub.add_parser("put", help="put a thing into a container — id or "
                                    "a name in view, for both")
    p.add_argument("thing")
    p.add_argument("container")

    p = sub.add_parser("take_out", help="pull a thing out of its container "
                                        "(the world knows which one holds "
                                        "it) — id or a name inside a "
                                        "container in view")
    p.add_argument("thing")

    p = sub.add_parser("look_in", help="see what's inside a container — "
                                        "id or a name in view")
    p.add_argument("container")

    sub.add_parser("inv", help="what you're carrying, and your carry budget")

    p = sub.add_parser("send_home", help="remote-move a thing to your own post")
    p.add_argument("thing")

    p = sub.add_parser("act", help="execute a kind-declared action on a typed thing")
    p.add_argument("thing")
    p.add_argument("action")
    p.add_argument("--arg", action="append", metavar="k=v",
                   help="repeatable; each becomes a string entry in the args object")

    p = sub.add_parser("create-place", help="open a new purposed place")
    p.add_argument("label")
    p.add_argument("--desc", required=True, help="place description (required by the world)")
    p.add_argument("--kind", choices=("public", "private"), default=None)
    p.add_argument("--id", default=None, help="explicit place id (else derived from label)")
