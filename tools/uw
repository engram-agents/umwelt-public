_HEAR_MAX_LIMIT = 100


class UwError(Exception):
    """A uw-level problem to render on stderr and exit 1 — never a
    traceback. `status` is the HTTP status when this wraps a server error
    response; None for a uw-side problem (bad args, unreachable server, a
    bad --arg/--json file, missing identity)."""

    def __init__(self, message: str, status: int | None = None):
        super().__init__(message)
        self.status = status


# --------------------------------------------------------------------------
# Environment + state
# --------------------------------------------------------------------------

def resolve_url() -> str:
    return _client_auth.resolve_world_url().rstrip("/")


def resolve_agent() -> str:
    """UMWELT_AGENT env is the sole non-interactive identity source (see the
    module docstring's Env section) — fail loud rather than guess."""
    raw = os.environ.get("UMWELT_AGENT", "").strip()
    if not raw:
        raise UwError(
            "no agent identity — set UMWELT_AGENT (e.g. `export "
            "UMWELT_AGENT=lei`); uw never guesses an identity and never "
            "runs anonymous"
        )
    return raw


def _agent_or_none() -> str | None:
    """Non-raising identity read — UMWELT_AGENT or None.

    Some verbs act anonymously (they call `call()` without needing an
    avatar), so `call()` cannot inject `resolve_agent()` (which raises).
    When this returns None, `call()` sends no auth header — today's
    anonymous behavior, unchanged. When it returns an agent, `call()`
    acquires a session token via client_auth (umwelt #495)."""
    raw = os.environ.get("UMWELT_AGENT", "").strip()
    return raw or None


def _self_lineage() -> str | None:
    """This seat's ``self_lineage`` from ``~/.engram/config.json``, or None
    when unknown (umwelt#861 D9). Valid only in ``provider:family`` shape:
    a str, lowercase, exactly one colon, both parts non-empty. Missing /
    unreadable / malformed is unknown; uw never invents a lineage. Twin of
    mcp_server._self_lineage -- uw cannot share code with the plugin file."""
    try:
        with open(os.path.expanduser("~/.engram/config.json"), encoding="utf-8") as fh:
            value = json.load(fh).get("self_lineage")
    except (OSError, ValueError, AttributeError):
        return None
    if not isinstance(value, str) or value != value.lower():
        return None
    provider, sep, family = value.partition(":")
    if not sep or not provider or not family or ":" in family:
        return None
    return value


def _stamp_sender_lineage(payload: dict) -> dict:
    """The one stamping point for every uw crossing send (umwelt#861 D9):
    sets ``sender_lineage`` from a known ``self_lineage``, else leaves the
    payload untouched. uw takes no caller-supplied lineage."""
    known = _self_lineage()
    if known is not None:
        payload["sender_lineage"] = known
    return payload


def load_state() -> dict:
    if STATE_PATH.exists():
        try:
            return json.loads(STATE_PATH.read_text())
        except (json.JSONDecodeError, OSError):
            return {}
    return {}


def save_state(**kw: Any) -> None:
    # Extend-only: the pager-bell monitor reads `place` from this same file
    # (issue #111's spec) — never rewrite the file wholesale, always merge.
    state = load_state()
    state.update(kw)
    STATE_PATH.write_text(json.dumps(state))


def now_iso() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.%f")[:-3] + "Z"


# --------------------------------------------------------------------------
# Transport — the single seam tests monkeypatch.
# --------------------------------------------------------------------------

# Per-invocation session token cache (umwelt #495), now backed by an
# opt-in ON-DISK cache across invocations (umwelt #805, Kepler's 2026-09-18
# security ruling): `uw` is single-shot (one process per invocation), so an
# in-memory-only session was previously re-minting a fresh token on every
# single `uw` call -- see client_auth.py's module docstring for the five
# conditions this must (and does) satisfy. `cache=True` is passed at the
# get_auth_header() call site below; this AgentSession object itself is
# unchanged (the disk layer is opt-in per-call, not per-session).
_UW_SESSION = _client_auth.AgentSession()


def call_once(method: str, path: str, payload: dict | None,
              auth_headers: dict[str, str]) -> tuple[int, dict]:
    """Single low-level HTTP call -> (status, body_dict). Raises UwError (no
    status — a transport failure means the world never answered) if the
    server is unreachable. ``auth_headers`` (the Authorization dict from
    client_auth, possibly empty) is merged into the request headers — empty
    dict = today's anonymous/declared behavior."""
    url = f"{resolve_url()}{path}"
    data = json.dumps(payload).encode() if payload is not None else None
    headers = {"Content-Type": "application/json"} if data is not None else {}
    if auth_headers:
        headers.update(auth_headers)
    req = urllib.request.Request(url, data=data, method=method, headers=headers)
    try:
        with _client_auth.urlopen_with_cert_fallback(req, 30) as r:
            body = r.read().decode()
            return r.status, (json.loads(body) if body else {})
    except urllib.error.HTTPError as e:
        body = e.read().decode()
        try:
            return e.code, (json.loads(body) if body else {})
        except json.JSONDecodeError:
            return e.code, {"error": body or f"HTTP {e.code}"}
    except (urllib.error.URLError, OSError, ValueError) as e:
        raise UwError(f"cannot reach the world at {resolve_url()}: {e}") from e


def call(method: str, path: str, payload: dict | None = None) -> tuple[int, dict]:
    """Low-level HTTP call with client-auth + 401-retry-once (umwelt #495).

    Acquires an ``Authorization`` header from ``client_auth`` when an agent
    identity is set (no agent → anonymous request, no header — today's
    behavior for the verbs that don't act as an avatar). On a 401 from a
    bearer-authed request the cached token is invalidated and retried once
    with a fresh token; the server is the authority on token validity.

    The header is ADDITIVE — the agent identity in the request body is NOT
    dropped when a token is present. The server still requires ``agent`` in
    the body even with a valid token (400 'agent is required' otherwise), and
    ``resolve_actor`` lets the token OVERRIDE the declared param rather than
    replace it. Do not design toward omitting the body param. (Ariadne,
    end-to-end finding, 2026-08-18 — measured on alpha against 1d5b90f.)

    Key-present-but-auth-fails raises ``AuthFailure`` (fail closed — do not
    silently fall back to declared); caught and re-raised as UwError. No-key
    + fallback-disabled also fails closed. (Mira security ruling, 2026-08-18.)
    """
    for attempt in range(2):  # initial + one retry on a 401 of a bearer req
        agent = _agent_or_none()
        auth_headers: dict[str, str] = {}
        if agent is not None:
            try:
                auth_headers = _client_auth.get_auth_header(
                    resolve_url(), agent, _UW_SESSION, cache=True
                )
            except _client_auth.AuthFailure as e:
                raise UwError(
                    f"authentication failed: {e}", status=401
                ) from e
        status, body = call_once(method, path, payload, auth_headers)
        # Retry once only if we sent a bearer token and the server rejected it.
        if status == 401 and attempt == 0 and auth_headers:
            _UW_SESSION.invalidate()
            continue
        return status, body
    return status, body  # pragma: no cover (loop always returns above)


def request(method: str, path: str, payload: dict | None = None) -> dict:
    """call() + status-gate: raises UwError(status=...) on >=400, else
    returns the parsed body dict."""
    status, body = call(method, path, payload)
    if status >= 400:
        raise UwError(
            body.get("error", f"request failed (status {status})"),
            status=status,
        )
    return body


# --------------------------------------------------------------------------
# Rendering — concise human lines by default.
# --------------------------------------------------------------------------

def _print_json(obj: Any) -> None:
    print(json.dumps(obj, indent=1, ensure_ascii=False))


def _view_notes(view: dict) -> list[str]:
    """The trailing `(your body is here now)` / `(ignored on reconnect: …)`
    notes — shared by both render modes."""
    notes = []
    if view.get("born") is True:
        notes.append("(your body is here now)")
    ignored = view.get("ignored")
    if ignored:
        notes.append(f"(ignored on reconnect: {', '.join(ignored)})")
    return notes


def _render_arrival_counts(view: dict) -> list[str]:
    """umwelt#928: the brief arrival body — a counts line and a pointer
    line. mcp_server.py's `_render_arrival_counts` is the twin (separate
    file across the plugin boundary); keep the counts-line shape identical.
    The pointer names `uw look` only: `uw places` lists every place in the
    world, not the exits from here, and `uw look` shows those."""
    n = len(view.get("things") or [])
    parts = [f"{n} thing{'s' if n != 1 else ''}"]
    present = view.get("present") or []
    if 1 <= len(present) <= 5:
        parts.append("present: " + ", ".join(
            p.get("name") or p.get("agent") or "someone" for p in present))
    elif present:
        parts.append(f"{len(present)} present")
    unseen = view.get("unseen_count") or 0
    if unseen:
        parts.append(f"{unseen} unseen crossing{'s' if unseen != 1 else ''}"
                     f" — 'hear' to read")
    exits = sum(1 for r in (view.get("reachable") or [])
                if r.get("relation") != "parent")
    parts.append(f"{exits} exit{'s' if exits != 1 else ''}")
    return [" · ".join(parts), "uw look for the room and its exits"]


def _render_place(view: dict, arrival: bool = False) -> str:
    """Render a place view (umwelt #214's uw-side mirror of
    mcp_server._render_place_view — same content/order, uw's own line
    shape).

    umwelt#928: pass `arrival=True` (move, enter, register) for the BRIEF
    render — the `== label ==` header, one counts line, one pointer line to
    `uw look`, and the born/ignored notes. No description, no thing lines,
    no exit list. `arrival=False` (the default; `look`'s only mode) is
    byte-identical to the render this function has always produced.
    """
    place = view.get("place") or {}
    lines = [f"== {place.get('label') or place.get('id', '?')} =="]
    if arrival:
        return "\n".join(lines + _render_arrival_counts(view) + _view_notes(view))
    desc = place.get("description")
    if desc:
        lines.append(desc)

    present = view.get("present") or []
    if present:
        tags = [p.get("name") or p.get("agent") or "someone" for p in present]
        lines.append("present: " + ", ".join(tags))

    things = view.get("things") or []
    for i, t in enumerate(things, 1):
        d = t.get("description") or ""
        lines.append(f"{i}. {t['name']}" + (f" — {d}" if d else ""))

    unseen = view.get("unseen_count") or 0
    if unseen:
        lines.append(f"{unseen} unseen crossing{'s' if unseen != 1 else ''} — 'hear' to read")

    # umwelt #158: sub-places + lateral links reachable from here (the
    # engine data is db.place_tree(depth=1); the server sends it structured
    # as view["reachable"], this is the one place that turns it into prose).
    # umwelt #239 (folded into #241): `reachable` now also carries a typed
    # parent entry (`relation: "parent"`) — excluded here to keep this
    # prose line's behavior unchanged; mcp_server.py's `_render_place_view`
    # makes the identical exclusion, for the identical reason (see its own
    # comment) — the two must never drift per this function's own docstring.
    reachable = [r for r in (view.get("reachable") or [])
                 if r.get("relation") != "parent"]
    if reachable:
        labels = [r.get("label") or r.get("id") for r in reachable]
        lines.append("from here you can reach: " + ", ".join(labels))

    lines.extend(_view_notes(view))

    return "\n".join(lines)


def _render_thing(thing: dict) -> str:
    lines = [f"{thing.get('name', '?')} ({thing.get('kind', '?')})"]
    desc = thing.get("description")
    if desc:
        lines.append(desc)
    return "\n".join(lines)


def _render_avatar_status(status: dict) -> str:
    """#143's look_at status block (emotion + last_action + last_active_at
    + Phase 2's state/activity_line) — plain labeled lines, the file's
    house style (see _render_health / _render_carry_result). Timestamps
    are left exactly as the server sent them (the module docstring's
    "human-readable timestamps left as-is" convention, same as
    _render_hear). Kind-dispatch + state composition are shared with
    mcp_server.py and mud.py via umwelt.avatar_status (#178)."""
    lines = [f"emotion: {status.get('emotion')}"]
    last_action = status.get("last_action")
    action_desc = _avatar_status.describe_last_action(last_action)
    if action_desc:
        at = (last_action or {}).get("at")
        lines.append(f"last action: {action_desc} at {at}")
    last_active_at = status.get("last_active_at")
    if last_active_at:
        lines.append(f"last active: {last_active_at}")
    state_line = _avatar_status.describe_state(status)
    if state_line:
        lines.append(f"state: {state_line}")
    return "\n".join(lines)


def _render_params_spec(resp: dict) -> str:
    """umwelt #396: a params-declaring readable/executable/blueprint
    returns a `params_spec` sibling key (not `outcome`) when use() is
    called with empty args (the caller's "--help") or args that failed to
    bind (spec + `error`). `cmd_use` must render this explicitly — falling
    through to `_render_use_outcome(resp.get("outcome", {}))` would silently
    print a blank/near-empty line, since this response shape never carries
    an `outcome` key at all."""
    spec = resp.get("params_spec") or {}
    lines = []
    err = resp.get("error")
    if err:
        lines.append(f"the world says: {err}")
    lines.append(f"{spec.get('name', '?')} takes these params:")
    params = spec.get("params") or []
    if not params:
        lines.append("  (none declared)")
    for p in params:
        bits = [p.get("type", "string"),
                "required" if p.get("required") else "optional"]
        if p.get("enum"):
            bits.append(f"enum={p['enum']}")
        if not p.get("required") and "default" in p:
            bits.append(f"default={p['default']!r}")
        line = f"  - {p.get('name', '?')} ({', '.join(bits)})"
        if p.get("description"):
            line += f" — {p['description']}"
        lines.append(line)
    return "\n".join(lines)


def _render_use_outcome(outcome: dict) -> str:
    if "error" in outcome:
        return f"the world says: {outcome['error']}"
    if outcome.get("kind") == "readable":
        lines = []
        briefing = outcome.get("briefing")
        if briefing:
            lines.append(briefing)
        content = outcome.get("content") or {}
        if not content:
            lines.append("(empty)")
        for fname, text in content.items():
            lines.append(f"--- {fname} ---")
            lines.append(text if text else "(empty)")
        return "\n".join(lines)

    lines = []
    briefing = outcome.get("briefing")
    if briefing:
        lines.append(briefing)
    stdout = (outcome.get("stdout") or "").strip()
    if stdout:
        lines.append("--- stdout ---")
        lines.append(stdout)
    stderr = (outcome.get("stderr") or "").strip()
    if stderr:
        lines.append("--- stderr ---")
        lines.append(stderr)
    return "\n".join(lines)


def _render_carry_result(verb: str, token: str, resp: dict) -> str:
    load = resp.get("load")
    capacity = resp.get("capacity")
    if load is not None and capacity is not None:
        return f"{verb} {token} — carrying {load}/{capacity}"
    return f"{verb} {token}."


def _render_inventory(inv: dict) -> str:
    things = inv.get("things") or []
    lines = [f"{t['name']} — {t.get('weight_est')}" for t in things]
    load = inv.get("load", 0)
    capacity = inv.get("capacity", 0)
    headroom = inv.get("headroom", capacity - load)
    lines.append(
        f"carrying {len(things)} things — load {load} / capacity {capacity} "
        f"(headroom {headroom})"
    )
    return "\n".join(lines)


def _render_container_contents(look: dict) -> str:
    things = look.get("things") or []
    # umwelt #261 dotted-path follow-up: numbered so a caller can address
    # what they just saw as "N.M" — mirrors the place render's own
    # 1-indexed numbering (`_resolve_dotted_ordinal` indexes this same
    # order via a fresh look_in call, so the number shown here IS the M).
    lines = ([f"{i}. {t['name']} — {t.get('weight_est')}"
              for i, t in enumerate(things, 1)] or ["(empty)"])
    load = look.get("load", 0)
    capacity = look.get("capacity", 0)
    lines.append(f"bag load {load} / capacity {capacity}")
    return "\n".join(lines)


def _render_hear(resp: dict, place: str) -> str:
    # seq, sender, relation, body — the prototype's rendering style
    # (issue #111's explicit ask), own sends (viewer_relation == "sender")
    # skipped in the listing but still counted in the cursor advance.
    crossings = resp.get("crossings") or []
    lines = []
    for c in crossings:
        rel = c.get("viewer_relation", "?")
        if rel == "sender":
            continue
        to = f" →{c['to_agent']}" if c.get("to_agent") else ""
        body = c.get("body") or c.get("body_ref") or "(no body)"
        lines.append(
            f"[{c.get('seq')}] {c.get('sender')}{to} ({rel}) "
            f"{c.get('received_at', '')[:16]}:\n  {body}"
        )
    if not crossings:
        lines.append(f"(quiet — no new crossings in {place} since {resp.get('from_position')})")
    # umwelt#616: the server always computes `skipped` (how many additional
    # qualifying crossings existed beyond what this response returned) —
    # rendering nothing when it's non-zero is the silent-truncation shape
    # this fix exists to close. 0/absent (the common case) renders nothing
    # extra — unchanged from before.
    skipped = resp.get("skipped") or 0
    if skipped:
        lines.append(f"… and {skipped} more; run hear again")
    return "\n".join(lines)


def _render_places(places: list[dict]) -> str:
    lines = []
    for i, p in enumerate(places, 1):
        lines.append(f"{i}. {p.get('label', p['id'])} ({p['id']})")
    return "\n".join(lines) if lines else "(no places)"


# umwelt #160: the interactive map is a forest of place_tree-shaped nodes
# (one per visible top-level place) — this is the recursive analogue of
# _render_places above, walking `children` and rendering `links` inline per
# node (same annotation-not-recursion-level posture place_tree itself uses).
def _render_map_node(node: dict, depth: int, lines: list[str]) -> None:
    indent = "  " * depth
    label = node.get("label") or node.get("id")
    tags = []
    if node.get("kind") == "private":
        tags.append("private")
    unread = node.get("unread") or 0
    if unread:
        tags.append(f"{unread} unread")
    thing_count = node.get("thing_count") or 0
    if thing_count:
        tags.append(f"{thing_count} things")
    suffix = f" ({', '.join(tags)})" if tags else ""
    lines.append(f"{indent}- {label} [{node.get('id')}]{suffix}")
    for link in node.get("links") or []:
        link_label = f" ({link['link_label']})" if link.get("link_label") else ""
        lines.append(
            f"{indent}    -> {link.get('dst_label') or link.get('dst_id')} "
            f"[{link.get('dst_id')}]{link_label}"
        )
    for child in node.get("children") or []:
        _render_map_node(child, depth + 1, lines)


def _render_map_forest(roots: list[dict]) -> str:
    if not roots:
        return "(no places match)"
    lines: list[str] = []
    for root in roots:
        _render_map_node(root, 0, lines)
    return "\n".join(lines)


def _render_health(h: dict) -> str:
    lines = [f"status: {h.get('status')}"]
    # umwelt #1029: a degraded world says WHY on the line after `status:`.
    # A healthy probe or an old server (no key) adds nothing.
    probe = h.get("db_probe")
    if isinstance(probe, dict) and probe.get("ok") is False:
        lines.append(f"db_probe: {probe.get('error') or 'unknown error'}")
    lines.append(f"world: {h.get('world')}")
    for k in ("commit", "started_at", "world_version"):
        if h.get(k) is not None:
            lines.append(f"{k}: {h[k]}")
    # umwelt #991: the boot-time kinddef drift check is the one /health key
    # whose purpose is to be SEEN, so it is rendered rather than left to
    # --json. Absent on servers that predate it -> no line at all.
    kf = h.get("kinddef_files")
    if isinstance(kf, dict):
        missing = kf.get("missing") or []
        lines.append(f"kinddef_files: {kf.get('checked')} checked, "
                     f"{len(missing)} missing")
        for m in missing:
            lines.append(f"  {m.get('id')} ({m.get('name')}): {m.get('reason')}")
    return "\n".join(lines)


# --------------------------------------------------------------------------
# Thing-ref resolution (umwelt #135) — every thing-ref verb (look_at, use,
# take, drop, put, take_out, look_in) accepts either a thing id OR a plain
# name, resolved against what's actually in view: the current place's
# things and, where relevant, the avatar's own carried inventory. An id
# match wins outright (no ambiguity possible); a name match is case-
# insensitive exact — zero matches or more than one are both loud, named
# uw-side errors rather than a raw 404 from the server (which only ever
# understands ids).
# --------------------------------------------------------------------------

def _current_place_view(agent: str) -> dict:
    """The full /umwelt/look response for the caller's current place —
    umwelt #184/#219/forum #263: re-pointed off the side-effecting move_to
    (which teleported the avatar to a STALE cached `place` whenever the
    local state file drifted from the server's own idea of where the
    avatar stands, cmd_look's exact bug per PR2) onto the read-only
    `POST /umwelt/look`, which resolves the caller's current place
    SERVER-SIDE from the avatar's own place_id. No local `place` state
    read at all — this used to read _current_place() (now removed, no
    other caller), the same drift hazard cmd_look had.

    Shared by _list_place_things (which only needed `things`) and
    look_at's avatar-inclusive resolver (umwelt #146, which needs `things`
    AND `present` off the SAME response) so the two don't double the
    network round-trip when both are needed together."""
    return request("POST", "/umwelt/look", {"agent": agent})


def _list_place_things(agent: str) -> list[dict]:
    return _current_place_view(agent).get("things") or []


def _list_inventory_things(agent: str) -> list[dict]:
    try:
        resp = request("POST", "/umwelt/inventory", {"agent": agent})
    except UwError as e:
        # No avatar yet ("enter the world first") — nothing carried, not a
        # resolution-time failure; the caller may still resolve by id or a
        # name visible in the current place.
        if e.status == 404:
            return []
        raise
    return resp.get("things") or []


def _match_candidates(ref: str, candidates: list[dict]) -> str:
    for t in candidates:
        if t.get("id") == ref:
            return ref
    lower_ref = ref.lower()
    matches: dict[str, dict] = {}
    for t in candidates:
        if (t.get("name") or "").lower() == lower_ref:
            matches[t["id"]] = t
    if not matches:
        raise UwError(
            f"no thing matching {ref!r} here — checked ids and names in "
            "your current place and inventory"
        )
    if len(matches) > 1:
        listing = "; ".join(f"{t.get('name')} ({tid})" for tid, t in matches.items())
        raise UwError(f"{ref!r} matches more than one thing — specify by id: {listing}")
    return next(iter(matches))


_ORDINAL_RE = re.compile(r"\A\d+\Z")


def _resolve_ordinal(ref: str, place_things: list[dict]) -> str | None:
    """umwelt #261 Gap A — mirror of mcp_server.py's `_resolve_ordinal`
    (same ordering-source pin, same TOCTOU posture), written to this
    file's own convention: a bare integer ref (`^\\d+$`) resolves, ALWAYS
    and unconditionally, as a 1-indexed ordinal into `place_things` (the
    SAME list `_render_place` numbers as its `f"{i}. {t['name']}"` lines)
    — never falls through to name-match first.

    Returns None immediately when `ref` isn't digit-shaped, so callers
    fall through to their existing name/uuid match unchanged. When
    digit-shaped: in 1-indexed range, returns the thing id; out of range,
    raises UwError (loud, never a silent wrong-thing resolve) — a
    digit-shaped ref never falls through to name/uuid matching, in or out
    of range.

    A thing whose `name` happens to be a pure integer (e.g. "3") is no
    longer name-addressable via a bare ref — still reachable by its uuid.
    Rare, accepted at v0, not mitigated here.

    TOCTOU note: `place_things` order is stable under append (new things
    append at the tail, existing ordinals don't shift) but a removal
    (trash/take) between when the caller rendered the place and when they
    act shifts every ordinal after the removed item down by one. This is a
    known v0 property, not a bug to fix: the out-of-range error is the
    loud signal, a shifted-but-in-range ordinal is the accepted v0 risk,
    mitigated by the outcome briefing naming the actually-acted-on thing."""
    if not _ORDINAL_RE.match(ref):
        return None
    n = int(ref)
    if 1 <= n <= len(place_things):
        return place_things[n - 1]["id"]
    raise UwError(f"ordinal {n} out of range — {len(place_things)} thing(s) here; re-look")


_DOTTED_ORDINAL_RE = re.compile(r"\A(\d+)\.(\d+)\Z")


def _resolve_dotted_ordinal(agent: str, ref: str, place_things: list[dict]) -> str | None:
    """umwelt #261 dotted-path container addressing — mirror of
    mcp_server.py's own `_resolve_dotted_ordinal`, written to this file's
    own raise-UwError convention. Extends Gap A's flat ordinal one level
    deeper: a ref shaped `N.M` (e.g. "3.1") resolves N as a 1-indexed
    ordinal into `place_things` (identical rule to `_resolve_ordinal`),
    requires that thing be `kind == "container"`, then resolves M as a
    1-indexed ordinal into THAT container's own contents, in the exact
    order `POST /umwelt/look_in` returns them (the same order look_in's
    own render numbers) — so "N.M" means "the Mth thing look_in on item N
    would show you".

    Returns None immediately when `ref` isn't dotted-ordinal-shaped, so
    callers fall through to their existing ordinal/name/uuid path
    unchanged. Every other outcome is terminal (a resolved id, or a raised
    UwError) — a dotted-shaped ref never falls through to name/uuid
    matching, in range or out.

    v0 scope: PLACE containers only, one level deep — matches
    `_resolve_ordinal`'s own place-only scope (never indexes inventory);
    an inventory-held container is out of scope, and a bagged thing that
    is itself a container is not recursively indexed.

    This WIDENS RESOLUTION only — which ref string maps to which thing
    id. It does NOT touch `_reachable`'s server-side closed-bag rule
    (server.py): a mutating verb (take/put/etc.) resolved through this
    path still fails its own reachability gate, exactly as it does for a
    direct uuid ref to a bagged thing today."""
    m = _DOTTED_ORDINAL_RE.match(ref)
    if not m:
        return None
    outer, inner = int(m.group(1)), int(m.group(2))
    if not (1 <= outer <= len(place_things)):
        raise UwError(f"ordinal {outer} out of range — {len(place_things)} thing(s) here; re-look")
    container = place_things[outer - 1]
    if container.get("kind") != "container":
        raise UwError(
            f"item {outer} is {container.get('name')!r}, not a container — "
            "nothing to index inside it"
        )
    look = request("POST", "/umwelt/look_in",
                    {"agent": agent, "container": container["id"]})
    contents = look.get("things") or []
    if not (1 <= inner <= len(contents)):
        raise UwError(
            f"ordinal {inner} out of range — {len(contents)} thing(s) in "
            f"{container.get('name')!r}; look_in it again"
        )
    return contents[inner - 1]["id"]


def _resolve_thing(agent: str, ref: str, *,
                    place: bool = True, inventory: bool = True,
                    containers: bool = False,
                    passthrough_id: bool = False) -> str:
    """Resolve `ref` (an id or a name) to a thing id. `containers=True`
    (take_out's own case — the CLI has no separate <container> arg, the
    server derives it from the thing's own holder) additionally looks
    inside every container currently in view, since a bagged thing appears
    in neither the place's nor the avatar's own listing. Bounded to one
    level of scanning — "bags don't go in bags (yet)" (umwelt #88 v1 rule)
    means that's exhaustive.

    umwelt #261 Gap A: when `place=True`, a bare integer ref resolves
    first, unconditionally, as a 1-indexed ordinal into the place's own
    things (`_resolve_ordinal`) — before this candidate set even grows to
    include inventory or the containers scan, so the ordinal never indexes
    anything but the place-things list the caller's own numbered render
    shows. `place=False` (drop's candidate set) skips the ordinal branch
    entirely — a bare integer there has no ordinal meaning and falls
    through to name/uuid matching unchanged.

    umwelt #261 dotted-path follow-up: when `place=True`, a ref shaped
    `N.M` is checked FIRST (`_resolve_dotted_ordinal`, more specific
    pattern first), before the flat-ordinal check — a dotted ref never
    matches the flat `^\\d+$` pattern anyway, so this ordering is for
    readability, not correctness. Skipped entirely when `place=False`,
    same posture as the flat-ordinal branch.

    umwelt #984: `passthrough_id=True` (default OFF; only `use` sets it)
    adds the same id-shaped pass-through `_resolve_look_at_target` has
    (#978), applied only after id/name/ordinal matching found NOTHING: a
    well-formed uuid (`_ids.looks_like_thing_id`) that no candidate is
    NAMED is returned unchanged for the server to resolve (e.g. a thing
    nested in a container this view does not enumerate). Ambiguity (>1
    name hit) and non-id-shaped misses keep the loud client-side error.
    This adds no reach/privacy gate (the server's use checks identity
    only; #982 tracks that)."""
    candidates: list[dict] = []
    if place:
        place_things = _list_place_things(agent)
        dotted_id = _resolve_dotted_ordinal(agent, ref, place_things)
        if dotted_id is not None:
            return dotted_id
        ordinal_id = _resolve_ordinal(ref, place_things)
        if ordinal_id is not None:
            return ordinal_id
        candidates += place_things
    if inventory:
        candidates += _list_inventory_things(agent)
    if containers:
        seen_containers: set[str] = set()
        for t in list(candidates):
            cid = t.get("id")
            if not cid or cid in seen_containers:
                continue
            seen_containers.add(cid)
            try:
                look = request("POST", "/umwelt/look_in",
                                {"agent": agent, "container": cid})
            except UwError as e:
                # Skip only the "this isn't a lookable container" shapes
                # (404/409/422). A transport failure (status None) or 5xx
                # must surface loudly — swallowing it would degrade a real
                # outage into a false "no thing matching" from the resolver.
                if e.status not in (404, 409, 422):
                    raise
                continue
            candidates += look.get("things") or []
    try:
        return _match_candidates(ref, candidates)
    except UwError:
        if passthrough_id and _looks_like_thing_id(ref) and not any(
                (t.get("name") or "").lower() == ref.lower() for t in candidates):
            return ref
        raise


# --------------------------------------------------------------------------
# look_at's OWN avatar-inclusive resolution (umwelt #146) — #143 added an
# avatar look_at status block (emotion + last_action + last_active_at) that
# was engine-complete but unreachable from uw: _resolve_thing above is the
# SHARED scan every thing-ref verb uses, and it deliberately excludes
# avatars (presence, not things — they must never become take/use/drop/
# put-able by accident). This is a look_at-specific superset of that scan,
# not a change to _resolve_thing itself or its behavior for any other verb.
# --------------------------------------------------------------------------

def _normalize_avatar(avatar: dict) -> dict:
    """A present-avatar summary (`{"agent", "avatar_id", "name", ...}` —
    `_present_summary`'s shape on the server, umwelt #133) copied with
    `avatar_id` remapped to `id`, so it plugs into _match_candidates's
    uniform `t.get("id")` / `t.get("name")` lookups alongside thing dicts
    (which already key their id as `id`). Returns a COPY — never mutates
    the caller's own dict.

    Id-collision safety (umwelt #146 review): avatars and things are rows
    in the SAME `things` table (db.py's schema), both minted via
    uuid.uuid4() (avatar birth in db.py, thing creation in server.py) —
    same generation scheme, same PRIMARY KEY column. Collision is therefore
    ruled out by the database's own uniqueness constraint, not by any
    namespace separation this client relies on."""
    return {**avatar, "id": avatar.get("avatar_id")}


def _resolve_look_at_target(agent: str, ref: str) -> str:
    """Resolve `ref` (an id or a name) to a thing id, for look_at only —
    the current place's things, the avatar's own inventory (same two
    scopes _resolve_thing(place=True, inventory=True) would use), PLUS
    present avatars in the current place, matched by avatar_id or
    case-insensitive name. Same match/ambiguity/zero-match semantics as
    every other verb (_match_candidates) — a name collision between a
    thing and an avatar in the current place surfaces as the existing
    ambiguous-match error, listing both, never a silent pick.

    Fetches the place view once (_current_place_view) rather than once for
    things and again for present, since both come back on the same
    /umwelt/move_to response.

    umwelt #261 Gap A: a bare integer ref resolves first, unconditionally,
    as a 1-indexed ordinal into the place's own things (`_resolve_ordinal`)
    — checked BEFORE inventory/avatars ever enter the candidate set, so
    the ordinal only ever indexes what the caller's own numbered render
    showed.

    umwelt #261 dotted-path follow-up: a ref shaped `N.M` is checked FIRST
    (`_resolve_dotted_ordinal`, more specific pattern first), before the
    flat-ordinal check — a dotted ref never matches the flat `^\\d+$`
    pattern anyway, so this ordering is for readability, not correctness."""
    view = _current_place_view(agent)
    place_things = list(view.get("things") or [])
    dotted_id = _resolve_dotted_ordinal(agent, ref, place_things)
    if dotted_id is not None:
        return dotted_id
    ordinal_id = _resolve_ordinal(ref, place_things)
    if ordinal_id is not None:
        return ordinal_id
    candidates: list[dict] = list(place_things)
    candidates += _list_inventory_things(agent)
    candidates += [_normalize_avatar(a) for a in (view.get("present") or [])]
    try:
        return _match_candidates(ref, candidates)
    except UwError:
        # umwelt #978: same id-shaped pass-through mcp_server's resolvers have
        # (#185 rule 4) -- only after id/name/ordinal/avatar matching found
        # NOTHING. ANY well-formed uuid is sent to the server (e.g. a thing
        # nested in a container this view does not enumerate). The server's
        # look_at today checks identity only -- no reach/status/privacy gate
        # (pre-existing, tracked as a separate issue); this pass-through does
        # not add or imply one. Ambiguity (>1 name hit) and non-id-shaped
        # misses keep the loud client-side error.
        if _looks_like_thing_id(ref) and not any(
                (t.get("name") or "").lower() == ref.lower() for t in candidates):
            return ref
        raise


def _prepare_use_args(raw: str) -> list[str]:
    """Translate uw's `use <thing> [args]` CLI token into use()'s server
    contract (umwelt #57, enforced by _validate_use_args server-side): args
    MUST be a JSON array of strings — a bare object 422s with "args must be
    an array of strings (got object)", so reject that shape client-side
    with the same wording rather than let it surface confusingly late. A
    JSON array passes straight through; anything else (a bare unquoted
    string, or any other JSON scalar) is wrapped as the single argv token
    the caller plainly meant (issue #135)."""
    try:
        parsed = json.loads(raw)
    except json.JSONDecodeError:
        return [raw]
    if isinstance(parsed, list):
        return parsed
    if isinstance(parsed, dict):
        raise UwError(
            "use args must be a JSON array of strings, e.g. "
            "'[\"a\",\"b\"]' — the server's use() contract rejects an "
            "object (\"args must be an array of strings\")"
        )
    return [raw]


