    _print_json(resp) if json_mode else print(_render_place(resp, arrival=True))


def cmd_customize_avatar(agent: str, args: argparse.Namespace, json_mode: bool) -> None:
    # Tri-state per string field (umwelt #55): omitted (None) -> leave
    # unchanged; "" -> clear (forwarded verbatim, unlike register's
    # truthiness-gated --desc/--lineage, since here "" is a meaningful
    # signal, not "nothing was typed"); non-empty -> set. carry_capacity is
    # numeric (umwelt #151) and has no string "" to repurpose on a shell, so
    # clearing it is a dedicated --clear-carry-capacity flag (Ariadne's
    # design ruling: null is the server's unambiguous clear-signal; a
    # repurposed sentinel int risks silently reinterpreting a caller's
    # mistake as "reset").
    payload: dict[str, Any] = {"agent": agent}
    if args.description is not None:
        payload["description"] = args.description
    if args.lineage is not None:
        payload["lineage"] = args.lineage
    if args.type is not None:
        payload["type"] = args.type
    if args.clear_carry_capacity:
        payload["carry_capacity"] = None
    elif args.carry_capacity is not None:
        payload["carry_capacity"] = args.carry_capacity
    resp = request("POST", "/umwelt/customize_avatar", payload)
    if json_mode:
        _print_json(resp)
        return
    a = resp.get("avatar", {})
    line = f"customized. description: {a.get('description')}"
    if a.get("type"):
        line += f" | type: {a['type']}"
    if a.get("lineage"):
        line += f" | lineage: {a['lineage']}"
    if a.get("carry_capacity"):
        line += f" | carry_capacity: {a['carry_capacity']}"
    print(line)


