    p.add_argument("place", help="the place id to reparent")
    p.add_argument("--parent", default=None,
                   help="the new parent place id (omit to clear back to top-level)")

    p = sub.add_parser("update-place", help="patch a place's metadata "
                                             "(place-lane-tiles spec) — "
                                             "owner-only, or any agent for "
                                             "an owner-less engine-genesis "
                                             "place")
    p.add_argument("place", help="the place id to patch")
    p.add_argument("--metadata-json", required=True,
                   help="JSON object (full replace, not a merge) — e.g. "
                        '\'{"lane_tiles": {"sky": {"class": "sky-tile"}}}\'')

    p = sub.add_parser("update-thing", help="patch a thing you authored — "
                                             "fix a mistaken forge without "
                                             "re-creating it (umwelt #294)")
    p.add_argument("thing", help="the thing id to patch (author-only)")
    p.add_argument("--name", default=None, help="new name")
    p.add_argument("--description", default=None, help="new description")
    p.add_argument("--exec-command", default=None,
                   help="new exec_command (executable things only)")
    p.add_argument("--metadata-json", default=None,
                   help="JSON object — MERGED into the thing's existing "
                        "metadata (existing keys not mentioned survive); "
                        "a null value for a key clears it, e.g. "
                        '\'{"render_spec": {"sprite": "lantern"}}\'')
    p.add_argument("--source-json", default=None,
                   help="JSON object mapping relative file paths to new "
                        "contents (full replace of source)")

    p = sub.add_parser("add-link", help="add a lateral link between two places")
    p.add_argument("src", help="the link's source place id")
    p.add_argument("dst", help="the link's destination place id")
    p.add_argument("--label", default=None, help="an optional label for the link")
    p.add_argument("--one-way", action="store_true",
                   help="write only src->dst (default: mutual, writes both directions)")

    p = sub.add_parser("remove-link", help="remove a lateral link between two places")
    p.add_argument("src", help="the link's source place id")
    p.add_argument("dst", help="the link's destination place id")
    p.add_argument("--one-way", action="store_true",
                   help="remove only src->dst (default: mutual, removes both directions)")

    p = sub.add_parser("checklist", help="check/uncheck/reset/add/remove/edit "
                                          "a thing's checklist items (umwelt #182)")
    p.add_argument("thing")
    p.add_argument("op", choices=("check", "uncheck", "reset", "add", "remove", "edit"))
    p.add_argument("value1", nargs="?", default=None,
                   help="item number (check/uncheck/remove/edit) or text (add)")
    p.add_argument("value2", nargs="?", default=None,
                   help="text (edit only, after the item number)")
    p.add_argument("--full", action="store_true",
                   help="print the full checklist block instead of the "
                        "default bounded one-item headline (umwelt #867). "
                        "Client-only — never sent to the world.")

    p = sub.add_parser("forge", help="create_thing from a spec file")
    p.add_argument("spec_file", help="path to a JSON create_thing spec")

    sub.add_parser("places", help="list every place in the world")
    sub.add_parser("health", help="the world server's health/version info")

    p = sub.add_parser("map", help="the interactive map — filterable "
                                    "full-forest view of every place "
                                    "visible to you (umwelt #160)")
    p.add_argument("--name", default=None,
                   help="case-insensitive substring filter on label")
    p.add_argument("--kind", choices=("public", "private"), default=None)
    p.add_argument("--owner", default=None, help="exact-match filter on owner")
    p.add_argument("--unread-only", action="store_true",
                   help="only show nodes with unread crossings")
    p.add_argument("--depth", type=int, default=None,
                   help="cap the walk depth per root (omit for unbounded)")

    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)

    try:
        if args.verb in _NO_IDENTITY_VERBS:
            if args.verb == "places":
                cmd_places(args, args.json)
            else:
                cmd_health(args, args.json)
            return 0

        agent_raw = resolve_agent()
        agent = _canonical_agent(agent_raw)

        handlers = {
            "enter": cmd_enter,
            "register": cmd_register,
            "customize-avatar": cmd_customize_avatar,
            "move": cmd_move,
            "look": cmd_look,
            "say": cmd_say,
            "wake": cmd_wake,
            "wake-block": cmd_wake_block,
            "wake-unblock": cmd_wake_unblock,
            "wake-blocks": cmd_wake_blocks,
            "hear": cmd_hear,
            "look_at": cmd_look_at,
            "use": cmd_use,
            "take": cmd_take,
            "drop": cmd_drop,
            "put": cmd_put,
            "take_out": cmd_take_out,
            "look_in": cmd_look_in,
            "inv": cmd_inv,
            "send_home": cmd_send_home,
            "act": cmd_act,
            "create-place": cmd_create_place,
            "set-parent": cmd_set_parent,
            "update-place": cmd_update_place,
            "update-thing": cmd_update_thing,
            "add-link": cmd_add_link,
            "remove-link": cmd_remove_link,
            "checklist": cmd_checklist,
            "forge": cmd_forge,
            "map": cmd_map,
        }
        handler = handlers[args.verb]
        handler(agent, args, args.json)
        return 0
    except UwError as e:
        prefix = f"{e.status} " if e.status is not None else ""
        print(f"uw: {args.verb}: {prefix}{e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
