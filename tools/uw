def cmd_checklist(agent: str, args: argparse.Namespace, json_mode: bool) -> None:
    # `value1`/`value2` carry different meanings per op (umwelt #182):
    #   check/uncheck/remove -> value1 = item (1-based)
    #   add                  -> value1 = text
    #   edit                 -> value1 = item, value2 = text
    #   reset                -> neither used
    payload: dict[str, Any] = {"agent": agent, "thing": args.thing, "op": args.op}
    if args.op in ("check", "uncheck", "remove"):
        if args.value1 is None:
            raise UwError(f"{args.op} requires an item number")
        try:
            payload["item"] = int(args.value1)
        except ValueError as e:
            raise UwError(f"item must be an integer (got {args.value1!r})") from e
    elif args.op == "add":
        if args.value1 is None:
            raise UwError("add requires text")
        payload["text"] = args.value1
    elif args.op == "edit":
        if args.value1 is None or args.value2 is None:
            raise UwError("edit requires an item number and text")
        try:
            payload["item"] = int(args.value1)
        except ValueError as e:
            raise UwError(f"item must be an integer (got {args.value1!r})") from e
        payload["text"] = args.value2
    resp = request("POST", "/umwelt/checklist", payload)
    if json_mode:
        _print_json(resp)
    elif args.full:
        # umwelt#867: --full is client-only (never posted above) and prints
        # the full block, unchanged from today's default.
        print(resp.get("render") or
              f"{args.thing}: {args.op} applied — "
              f"{resp.get('done_count')}/{resp.get('total')} done.")
    else:
        # umwelt#867: default is the bounded one-item headline; an older
        # world with no `headline` key falls back to the full block, then
        # to the applied-line, so an old server never loses output.
        print(resp.get("headline") or resp.get("render") or
              f"{args.thing}: {args.op} applied — "
              f"{resp.get('done_count')}/{resp.get('total')} done.")


def cmd_forge(agent: str, args: argparse.Namespace, json_mode: bool) -> None:
    try:
        spec = json.loads(Path(args.spec_file).read_text())
    except OSError as e:
        raise UwError(f"cannot read {args.spec_file!r}: {e}") from e
    except json.JSONDecodeError as e:
        raise UwError(f"{args.spec_file!r} is not valid JSON: {e}") from e
    place = load_state().get("place", DEFAULT_PLACE)
    # umwelt #950: the engine ignores a top-level `place` inside the spec (the
    # request's place wins; measured on a test world). Say so on stderr rather
    # than let the author believe the key placed the thing. Warning only: the
    # spec is forwarded unchanged and the exit status is not touched.
    if isinstance(spec, dict) and "place" in spec:
        print(f"uw: forge: warning: the spec's top-level 'place' "
              f"({spec['place']!r}) is ignored by the engine; the forge is "
              f"attempted in {place!r}, the place uw has on record for you "
              f"(the world refuses unless that is where you stand)",
              file=sys.stderr)
    resp = request("POST", "/umwelt/create_thing", {
        "agent": agent, "place": place, "spec": spec,
    })
    # umwelt #950: `place` here is the one POSTed above (client state), NOT a
    # read-back from the server. It makes a misplacement visible at the console
    # (compare it with where `uw look` says you stand); it does not prove where
    # the engine stored the thing. Keep the "thing id <id>" prefix stable.
    _print_json(resp) if json_mode else print(
        f"forged {spec.get('name')!r} — thing id {resp.get('thing_id')} "
        f"in {place}"
    )


