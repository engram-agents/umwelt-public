def cmd_update_thing(agent: str, args: argparse.Namespace, json_mode: bool) -> None:
    patch: dict[str, Any] = {}
    if args.name is not None:
        patch["name"] = args.name
    if args.description is not None:
        patch["description"] = args.description
    if args.exec_command is not None:
        patch["exec_command"] = args.exec_command
    if args.source_json is not None:
        try:
            patch["source"] = json.loads(args.source_json)
        except json.JSONDecodeError as e:
            raise UwError(f"--source-json is not valid JSON: {e}") from e
    if args.metadata_json is not None:
        try:
            meta_patch = json.loads(args.metadata_json)
        except json.JSONDecodeError as e:
            raise UwError(f"--metadata-json is not valid JSON: {e}") from e
        if not isinstance(meta_patch, dict):
            raise UwError("--metadata-json must be a JSON object")
        # umwelt #393: server.py's update_thing route now merges metadata
        # server-side for BOTH kind-typed AND untyped things (a null value
        # clears a key; an omitted key is left untouched) — previously only
        # kind-typed things got that merge, so this command used to fetch
        # the thing's current metadata, merge meta_patch into it client-
        # side, strip engine-owned keys the server would otherwise 422 on,
        # and refuse loudly on a graft-tracked thing whose patch didn't
        # address graft_ref (omission under the OLD full-replace-for-
        # untyped semantics would have silently DROPPED it, corrupting
        # advance_ref's compare-and-swap invariant). None of that is needed
        # now: the server merges, so omission means "leave unchanged" for
        # every thing, typed or not — the caller's own patch can be
        # forwarded exactly as given. The server still 422s on an explicit
        # attempt to SET action_log/graft_ref/graft_version (any thing) or
        # status/kind_id (kind-typed) — that's real protection, unaffected
        # by this simplification, and its error text surfaces via
        # request()'s normal >=400 handling below.
        patch["metadata"] = meta_patch

    if not patch:
        raise UwError("nothing to update — pass at least one of "
                      "--name/--description/--exec-command/--metadata-json/--source-json")

    resp = request("POST", "/umwelt/update_thing",
                   {"agent": agent, "thing": args.thing, "patch": patch})
    _print_json(resp) if json_mode else print(
        f"{args.thing} updated: {', '.join(sorted(resp.get('updated', [])))}"
    )


