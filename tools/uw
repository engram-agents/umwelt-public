def cmd_look(agent: str, args: argparse.Namespace, json_mode: bool) -> None:
    # umwelt #184/#219/forum #263: re-pointed off the side-effecting move_to
    # (which teleported the avatar to a STALE cached `place` whenever the
    # local state file drifted from the server's own idea of where the
    # avatar stands — the live bug Kepler hit) onto the read-only
    # `POST /umwelt/look`, which resolves the caller's current place
    # SERVER-SIDE from the avatar's own place_id — no local `place` state
    # read, no write of any kind. Re-saves the resolved place_id back into
    # local state on success (same convention as cmd_move/cmd_enter/
    # cmd_register) so the cache self-heals here rather than staying stale.
    resp = request("POST", "/umwelt/look", {"agent": agent})
    place_id = (resp.get("place") or {}).get("id")
    if place_id:
        save_state(place=place_id)
    _print_json(resp) if json_mode else print(_render_place(resp))


def cmd_say(agent: str, args: argparse.Namespace, json_mode: bool) -> None:
    place = load_state().get("place", DEFAULT_PLACE)
    text = " ".join(args.text)
    payload = {
        "agent": agent, "destination": place, "sent_at": now_iso(), "body": text,
    }
    if args.to:
        payload["to_agent"] = args.to
    # umwelt #133: emotion is a small, optional freeform tag on THIS
    # crossing — passed through only when given, never validated
    # client-side beyond that (the server owns the contract: 40-char cap,
    # 422 on violation — see server.py's _validate_emotion). Absent means
    # "let the server default it", same posture as every other optional
    # field on this payload.
    if args.emotion:
        payload["emotion"] = args.emotion
    # umwelt #119: mentions merge two sources — explicit --wake (comma-
    # separated) first, then @name tokens scanned out of the message text via
    # the shared umwelt.mentions.parse_mentions (umwelt #511 PR B; skips
    # quoted lines and fenced/inline code, unlike the old bare-regex scan) —
    # deduped, order preserved. The server is the authority on who's a real,
    # registered agent (silently drops unknown/self names, umwelt #119 slice
    # 1) — uw stays dumb here rather than keeping a second, potentially-stale
    # copy of the avatar registry.
    mentions: list[str] = []
    if args.wake:
        for name in args.wake.split(","):
            name = name.strip()
            if name and name not in mentions:
                mentions.append(name)
    for name in _mentions.parse_mentions(text):
        if name not in mentions:
            mentions.append(name)
    if mentions:
        payload["mentions"] = mentions
    resp = request("POST", "/umwelt/send_crossing", _stamp_sender_lineage(payload))
    # say must NEVER advance any place's read cursor (umwelt #111's
    # load-bearing rule — the live seq-26 bug the prototype fixed).
    if json_mode:
        _print_json(resp)
        return
    print(f"you say: {text}")
    rang = resp.get("wakes_granted") or []
    if rang:
        print(f"🔔 rang: {', '.join(rang)}")


_WAKE_DENIAL_REASONS = {
    "denied:rate": "they've hit their rate limit from you, try again shortly",
    "denied:consent": "they've blocked you",
    "denied:broadcast": "a wake needs an addressed recipient",
}


def cmd_wake(agent: str, args: argparse.Namespace, json_mode: bool) -> None:
    place = load_state().get("place", DEFAULT_PLACE)
    text = " ".join(args.text)
    payload = {
        "agent": agent, "destination": place, "sent_at": now_iso(), "body": text,
        "to_agent": args.to, "wake_me": True,
    }
    resp = request("POST", "/umwelt/send_crossing", _stamp_sender_lineage(payload))
    # wake must NEVER advance any place's read cursor — same cursor-discipline
    # rule as say (umwelt #111's load-bearing rule).
    if json_mode:
        _print_json(resp)
        return
    wake = resp.get("wake")
    if wake == "granted":
        print(f"🔔 woke {args.to}: {text}")
    else:
        reason = _WAKE_DENIAL_REASONS.get(wake, "wake not delivered")
        print(f"sent to {args.to}: {text} (wake NOT delivered — {reason})")


